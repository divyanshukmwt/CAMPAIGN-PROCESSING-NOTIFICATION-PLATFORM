# ==========================================================
# Backend Environment Configuration (backend/.env.example)
# ==========================================================

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
DEFAULT_TENANT_ID=default-tenant

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/campaign_platform

# Redis Configuration (BullMQ, Caching, Rate Limiting, Provider Deduplication)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Worker & Queue Configuration
WORKER_CONCURRENCY=10
CAMPAIGN_BATCH_SIZE=250
DELIVERY_MAX_ATTEMPTS=4
DELIVERY_BACKOFF_DELAY_MS=1000
WORKER_HEARTBEAT_INTERVAL_MS=5000

# Redis Cache TTL Configuration (in seconds)
CACHE_LIST_TTL_SECONDS=30
CACHE_SUMMARY_TTL_SECONDS=15
CACHE_DETAIL_TTL_SECONDS=15

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_READ_MAX=180

# Mock Notification Provider Simulation Settings
PROVIDER_MIN_LATENCY_MS=10
PROVIDER_MAX_LATENCY_MS=60
PROVIDER_DEFAULT_TRANSIENT_FAILURE_RATE=0.05
PROVIDER_IDEMPOTENCY_TTL_SECONDS=86400
